      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response time < 2 seconds', () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test('Content-Type is application/json', () => {",
              "    const ct = typeof pm.response.headers.get === 'function'",
              "        ? pm.response.headers.get('Content-Type')",
              "        : pm.response.headers.find(h => h.key.toLowerCase() === 'content-type')?.value;",
              "    pm.expect(ct).to.include('application/json');",
              "});",
              "",
              "pm.test('Response has token and user with role', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('token');",
              "    pm.expect(json.user).to.have.property('role');",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    const json = pm.response.json();",
              "    pm.collectionVariables.set('auth_token', json.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
